{
  "expo": {
    "name": "TopUpGame",
    "slug": "topup-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "topupgame",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121217"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.topupgame.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121217"
      },
      "package": "id.topupgame.mobile"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
